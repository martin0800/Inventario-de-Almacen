<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ALERTAS DE STOCK"
            android:textColor="#D32F2F"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="15dp" />

        <TextView
            android:id="@+id/tvTotalAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Productos con alertas: 0"
            android:textColor="@color/color_texto"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="18dp" />

        <LinearLayout
            android:id="@+id/contenedorAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/tvSinAlertas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay productos con stock bajo."
            android:textColor="@color/color_primario"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVolverAlertas"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#757575"
            android:text="VOLVER"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnVolverInventario"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="← VOLVER"
            android:textColor="#FFFFFF"
            android:backgroundTint="#455A64"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STOCK CONTROL"
            android:textColor="@color/color_primario"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONSULTA DE INVENTARIO"
            android:textColor="@color/color_texto"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="15dp"/>

        <TextView
            android:id="@+id/tvTotalProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total de productos: 0"
            android:textColor="@color/color_primario"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:id="@+id/contenedorProductos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="StockControl - Gestión de Inventario"
            android:textColor="@color/color_texto_secundario"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="20dp"/>

    </LinearLayout>

</ScrollView>